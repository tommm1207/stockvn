# ─── StockVN Environment Variables ─────────────────────────────────────────
# Copy file này thành .env rồi điền giá trị thật.

# Google Gemini AI – lấy free key tại https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# NVIDIA NIM fallback AI – lấy key tại https://build.nvidia.com
# Khi Gemini lỗi/hết quota, backend sẽ thử provider này trước khi dùng fallback local.
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=minimaxai/minimax-m2.7
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_TIMEOUT_SECONDS=45

# Telegram Bot – lấy token từ @BotFather trên Telegram
TELEGRAM_TOKEN=your_telegram_bot_token_here

# CORS origins (phân cách bằng dấu phẩy)
CORS_ALLOW_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Cache thư mục cho yfinance timezone data (mặc định: backend/.yfinance_cache)
# YFINANCE_CACHE_DIR=backend/.yfinance_cache

# SQLite database path (mặc định: backend/stockvn.db)
# SQLITE_PATH=backend/stockvn.db
